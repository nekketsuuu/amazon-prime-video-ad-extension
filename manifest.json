{
  "name": "Amazon Prime Video Ad Extension",
  "version": "1.0",
  "manifest_version": 3,
  "description": "Mutes ads on Amazon Prime Video.",
  "permissions": [
    "tabs",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  
  "content_scripts": [
    {
      "matches": [
        "*://www.amazon.com/gp/video/detail/*",
        "*://www.amazon.co.uk/gp/video/detail/*",
        "*://www.amazon.de/gp/video/detail/*",
        "*://www.amazon.co.jp/gp/video/detail/*"
      ],
      "js": ["content.js"]
    }
  ]
}